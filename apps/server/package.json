{
  "name": "@gp/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/websocket": "^11.3.4",
    "ajv": "^8.20.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@gp/mock-agent": "workspace:*",
    "@gp/mock-gateway": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "ws": "^8.22.0"
  }
}
